# ProofStack / Sentinel Gate Frontend Local Environment
# Configures the local Next.js client to communicate with the local FastAPI backend

# Base URL for the ProofStack FastAPI backend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8765

# 2-Minute Demo Video (YouTube)
NEXT_PUBLIC_DEMO_VIDEO_URL=https://youtu.be/EsdJ2vkg5HA
