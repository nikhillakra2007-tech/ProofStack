{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidenceLedgerEntrySchema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "tenant_id",
    "index",
    "type",
    "timestamp",
    "actor",
    "payload",
    "artifact_hashes",
    "hash_alg",
    "prev_hash",
    "entry_hash"
  ],
  "properties": {
    "task_id": {"type": "string"},
    "tenant_id": {"type": "string", "format": "uuid"},
    "index": {"type": "integer", "minimum": 0},
    "type": {
      "type": "string",
      "enum": [
        "TASK_INTAKE",
        "BASELINE",
        "HYPOTHESIS",
        "EXPERIMENT",
        "PATCH",
        "GATE_RESULT",
        "VERDICT",
        "MODEL_CALL",
        "HUMAN_APPROVAL",
        "DAST_TARGET",
        "DAST_SCAN",
        "DAST_FINDING",
        "REMEDIATION_PATCH",
        "REMEDIATION_VERDICT"
      ]
    },
    "timestamp": {"type": "string", "format": "date-time"},
    "actor": {"type": "string"},
    "payload": {"type": "object"},
    "artifact_hashes": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "hash_alg": {
      "type": "string",
      "enum": ["sha256"]
    },
    "prev_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "entry_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
