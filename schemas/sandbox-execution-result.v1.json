{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofstack.dev/schemas/sandbox-execution-result.v1.json",
  "title": "SandboxExecutionResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["session_id", "operation_id", "backend", "image_id", "command", "network_enabled", "exit_code", "signal", "timed_out",
               "wall_clock_ms", "max_rss_kb", "truncated", "stdout_path", "stderr_path", "stdout_sha256", "stderr_sha256",
               "limits_applied", "artifacts", "started_at", "finished_at"],
  "properties": {
    "session_id": {"type": "string", "description": "ProofStack run/session correlation id"},
    "operation_id": {"type": "string", "description": "backend operation UUID (nebius) or container id (docker)"},
    "backend": {"enum": ["nebius-sandboxes", "docker-hardened", "nsjail"]},
    "image_id": {"type": "string"},
    "result_image": {"type": ["string", "null"]},
    "command": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "network_enabled": {"type": "boolean"},
    "exit_code": {"type": ["integer", "null"]},
    "signal": {"type": ["integer", "null"]},
    "timed_out": {"type": "boolean"},
    "wall_clock_ms": {"type": ["integer", "null"], "minimum": 0},
    "max_rss_kb": {"type": ["integer", "null"], "minimum": 0},
    "cpu_user_ms": {"type": ["integer", "null"], "minimum": 0},
    "cpu_sys_ms": {"type": ["integer", "null"], "minimum": 0},
    "truncated": {"type": "boolean"},
    "stdout_path": {"type": "string"}, "stderr_path": {"type": "string"},
    "stdout_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "stderr_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "limits_applied": {
      "type": "object", "additionalProperties": false, "required": ["wall_clock_s", "memory_bytes", "processes"],
      "properties": {"wall_clock_s": {"type": "integer", "maximum": 60}, "memory_bytes": {"type": "integer", "maximum": 1073741824},
                     "processes": {"type": "integer", "maximum": 128}}
    },
    "artifacts": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes"],
      "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "bytes": {"type": "integer", "minimum": 0}}}},
    "started_at": {"type": "string", "format": "date-time"}, "finished_at": {"type": "string", "format": "date-time"}
  }
}
