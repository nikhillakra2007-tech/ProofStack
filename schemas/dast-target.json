{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DastTargetSchema",
  "type": "object",
  "additionalProperties": false,
  "required": ["target_id", "tenant_id", "url", "status", "proof", "repo"],
  "properties": {
    "target_id": {
      "type": "string",
      "pattern": "^tg_[0-9a-f]{12}$"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "url": {
      "type": "string",
      "pattern": "^https?://.+$"
    },
    "status": {
      "type": "string",
      "enum": ["PENDING", "VERIFIED", "REFUSED"]
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "verified_at"],
      "properties": {
        "method": {
          "type": "string",
          "enum": ["dns_txt", "well_known", "loopback_fixture"]
        },
        "verified_at": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    },
    "repo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "commit", "framework_hint"],
      "properties": {
        "source": {"type": "string"},
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "framework_hint": {
          "type": "string",
          "enum": ["nextjs", "express", "django", "static", "unknown"]
        }
      }
    }
  }
}
