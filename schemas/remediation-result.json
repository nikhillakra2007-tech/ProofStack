{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RemediationResultSchema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "remediation_id",
    "finding_id",
    "iteration",
    "diff_artifact",
    "files_changed",
    "gates",
    "reproduced_locally",
    "before",
    "after",
    "new_findings",
    "behaviour",
    "verdict",
    "reasons",
    "ledger_head"
  ],
  "properties": {
    "remediation_id": {
      "type": "string",
      "pattern": "^rm_[0-9a-f]{12}$"
    },
    "finding_id": {
      "type": "string",
      "pattern": "^fd_[0-9a-f]{12}$"
    },
    "iteration": {"type": "integer", "minimum": 1},
    "diff_artifact": {
      "type": "string",
      "pattern": "^art_[0-9a-f]{12}$"
    },
    "files_changed": {
      "type": "array",
      "items": {"type": "string"}
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["R0", "R1", "R2", "R3", "R4", "R5", "R6"],
      "properties": {
        "R0": {"type": "string", "enum": ["PASS", "FAIL", "NOT_RUN", "ERROR"]},
        "R1": {"type": "string", "enum": ["PASS", "FAIL", "NOT_RUN", "ERROR"]},
        "R2": {"type": "string", "enum": ["PASS", "FAIL", "NOT_RUN", "ERROR"]},
        "R3": {"type": "string", "enum": ["PASS", "FAIL", "NOT_RUN", "ERROR"]},
        "R4": {"type": "string", "enum": ["PASS", "FAIL", "NOT_RUN", "ERROR"]},
        "R5": {"type": "string", "enum": ["PASS", "FAIL", "NOT_RUN", "ERROR"]},
        "R6": {"type": "string", "enum": ["PASS", "FAIL", "NOT_RUN", "ERROR"]}
      }
    },
    "reproduced_locally": {"type": "boolean"},
    "before": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check", "state"],
      "properties": {
        "check": {"type": "string"},
        "state": {"type": "string", "enum": ["RED"]}
      }
    },
    "after": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check", "state"],
      "properties": {
        "check": {"type": "string"},
        "state": {"type": "string", "enum": ["GREEN", "RED"]}
      }
    },
    "new_findings": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^fd_[0-9a-f]{12}$"
      }
    },
    "behaviour": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tests_passed", "tests_failed", "smoke"],
      "properties": {
        "tests_passed": {"type": "integer"},
        "tests_failed": {"type": "integer"},
        "smoke": {"type": "string", "enum": ["PASS", "FAIL"]}
      }
    },
    "verdict": {
      "type": "string",
      "enum": ["ACCEPT", "REJECT", "INCONCLUSIVE"]
    },
    "reasons": {
      "type": "array",
      "items": {"type": "string"}
    },
    "ledger_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
