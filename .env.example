# Database
DATABASE_URL=sqlite:///./proofstack.db
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/proofstack
REDIS_URL=redis://localhost:6379/0

# Nebius Token Factory
NEBIUS_API_KEY=
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.ai/v1
SANDBOX_BACKEND=local_container # token_factory | local_container

# Server
PROOFSTACK_HOST=127.0.0.1
PROOFSTACK_PORT=8765
PROOFSTACK_CORS_ORIGINS=http://localhost:3000
PROOFSTACK_ENV=development

# Security
PROOFSTACK_SECRET_KEY=change-me-in-production
JWT_SECRET=dev-secret-do-not-use-in-prod-replace-with-rs256-key
AUTH_ALGORITHM=RS256

# Targets & Models
PROOFSTACK_TARGET=fixtures.demo_app
PROOFSTACK_MODEL_DIAGNOSIS=nvidia/nemotron-3-super-120b
PROOFSTACK_MODEL_PATCH=nvidia/nemotron-3.5-lightning
