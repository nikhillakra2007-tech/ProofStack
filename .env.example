# ==============================================================================
# ProofStack / Sentinel Gate — Environment Configuration Template
# Copy this file to .env for local development: cp .env.example .env
# ==============================================================================

# 1. APPLICATION ENVIRONMENT
# Options: development | test | production
PROOFSTACK_ENV=development
HOST=127.0.0.1
PORT=8765

# 2. DATABASE CONFIGURATION
# For Local Development / Offline Testing:
DATABASE_URL=sqlite:///./proofstack.db
# For PostgreSQL (Primary Shared Database / Production):
# POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/proofstack
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/proofstack

# 3. AUTHENTICATION & SECURITY
# Secret key used for signing JWT tokens and HMAC API signatures.
# In production, this MUST be a cryptographically random string (min 32 characters).
SECRET_KEY=change-me-in-production-dev-only-secret-key-32chars
JWT_SECRET=change-me-in-production-dev-only-secret-key-32chars
AUTH_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Restrictive CORS origins (comma-separated; never use '*' with credentials)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# 4. REDIS (Distributed Event Streaming & Multi-worker Coordination)
# Leave blank to use resilient in-memory EventBus during local development
REDIS_URL=redis://localhost:6379/0

# 5. NVIDIA NEMOTRON / NEBIUS AI INFERENCE (Optional)
# If omitted or unconfigured, ProofStack automatically runs in Deterministic Rule Fallback mode
NEBIUS_API_KEY=
NEBIUS_PROJECT_ID=
TOKEN_FACTORY_BASE_URL=https://api.studio.nebius.ai/v1
MODEL_DIAGNOSIS=nvidia/nemotron-3-super-120b
MODEL_PATCH=nvidia/nemotron-3.5-lightning

# 6. SANDBOX & EXECUTION RUNNER
SANDBOX_BACKEND=local_container
PROOFSTACK_TARGET=fixtures.demo_app
